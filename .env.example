AGENTX_DATA_DIR=./data
AGENTX_DEPLOYMENT_MODE=local
# Set for single-node API protection. Hosted deployments reject this by default and use OIDC.
AGENTX_API_TOKEN=
# Staging-only escape hatch for API-token/HMAC fallback alongside OIDC. Never enable in production.
AGENTX_ALLOW_HOSTED_BOOTSTRAP_AUTH=false
# Staging-only escape hatch for HTTP/disabled TLS dependencies. Never enable in production.
AGENTX_ALLOW_INSECURE_HOSTED=false
AGENTX_DATABASE_URL=
AGENTX_WORKSPACE_ID=
AGENTX_JWT_SECRET=
AGENTX_JWT_ISSUER=
AGENTX_JWT_AUDIENCE=
# Hosted OIDC verification requires a signed JWT access token with this audience; opaque tokens are not introspected.
AGENTX_OIDC_ISSUER=
# Optional internal discovery/JWKS route; hosted production requires HTTPS here too.
AGENTX_OIDC_BACKCHANNEL_URL=
# Public client registered for OAuth Device Authorization Grant. Required in hosted mode.
AGENTX_OIDC_CLI_CLIENT_ID=
AGENTX_OIDC_CLI_SCOPE=openid profile email offline_access
# Legacy single Ed25519 public key. Prefer the rotation key ring below.
AGENTX_ARTIFACT_PUBLIC_KEY=
# Comma-separated current and previous Ed25519 public keys during rotation overlap.
AGENTX_ARTIFACT_PUBLIC_KEYS=
AGENTX_ARTIFACT_STORE=file
AGENTX_S3_ENDPOINT=
AGENTX_S3_ACCESS_KEY=
AGENTX_S3_SECRET_KEY=
AGENTX_S3_BUCKET=agentx-artifacts
AGENTX_S3_SECURE=false
AGENTX_ALLOWED_ORIGINS=http://localhost:5178
AGENTX_TRUSTED_PROXIES=
AGENTX_RATE_LIMIT_PER_MINUTE=600
AGENTX_ALLOW_LEGACY_UNSCOPED=true
# Required in hosted mode. Supply owner/legal-approved public URLs and staffed contacts.
AGENTX_TERMS_URL=
AGENTX_PRIVACY_URL=
AGENTX_SUPPORT_URL=
AGENTX_ABUSE_EMAIL=
AGENTX_SECURITY_EMAIL=
# Hosted invitations require SMTP delivery. Use tls (implicit TLS) or starttls in production.
AGENTX_CONSOLE_URL=
AGENTX_SMTP_ADDRESS=
AGENTX_SMTP_USERNAME=
AGENTX_SMTP_PASSWORD=
AGENTX_SMTP_FROM=
AGENTX_SMTP_TLS_MODE=starttls
# Isolated hosted staging only; production rejects this bypass.
AGENTX_ALLOW_UNDELIVERED_INVITATIONS=false
# Hosted mode requires immutable OIDC issuer|subject principal IDs.
AGENTX_COMPLIANCE_ADMIN_IDS=
# Hosted mode requires an owner-approved positive retention duration.
AGENTX_AUDIT_RETENTION_DAYS=0
AGENTX_AUDIT_RETENTION_INTERVAL=24h
# Optional OpenTelemetry OTLP/HTTP exporter. Tracing is disabled when both endpoint variables are empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT overrides the general endpoint for traces.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=agentx-api
VITE_API_URL=http://localhost:8080
VITE_DEPLOYMENT_MODE=local
# Optional browser OIDC PKCE login for the Vue console.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:5178/
# Optional API scopes and provider-specific audience authorization parameter.
VITE_OIDC_SCOPE=openid profile email offline_access
VITE_OIDC_AUDIENCE=
