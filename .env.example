AGENTX_DATA_DIR=./data
# Set for single-node API protection. Hosted deployments should use OIDC.
AGENTX_API_TOKEN=
AGENTX_DATABASE_URL=
AGENTX_WORKSPACE_ID=
AGENTX_JWT_SECRET=
AGENTX_JWT_ISSUER=
AGENTX_JWT_AUDIENCE=
AGENTX_OIDC_ISSUER=
AGENTX_ARTIFACT_PUBLIC_KEY=
AGENTX_ARTIFACT_STORE=file
AGENTX_S3_ENDPOINT=
AGENTX_S3_ACCESS_KEY=
AGENTX_S3_SECRET_KEY=
AGENTX_S3_BUCKET=agentx-artifacts
AGENTX_S3_SECURE=false
AGENTX_ALLOW_LEGACY_UNSCOPED=false
VITE_API_URL=http://localhost:8080
VITE_API_TOKEN=
# Optional browser OIDC PKCE login for the Vue console.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:5178/
